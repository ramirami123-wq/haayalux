        "custom_liquid": "<style>.hx-routine{background:#FAF4EF;padding:56px 24px;font-family:Arial,sans-serif;color:#241A1A}.hx-routine-inner{max-width:1050px;margin:auto}.hx-routine h2{text-align:center;font-size:34px;margin:0 0 10px}.hx-routine .lead{text-align:center;color:#6B5A58;margin:0 auto 34px;max-width:650px}.hx-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.hx-step{background:#fff;border:1px solid #E8D8D2;border-radius:18px;padding:22px}.hx-num{display:inline-flex;width:34px;height:34px;align-items:center;justify-content:center;border-radius:50%;background:#7A1830;color:#fff;font-weight:700;margin-bottom:14px}.hx-step h3{font-size:17px;margin:0 0 8px}.hx-step p{font-size:14px;line-height:1.55;color:#6B5A58;margin:0}@media(max-width:749px){.hx-routine{padding:40px 18px}.hx-routine h2{font-size:28px}.hx-steps{grid-template-columns:1fr 1fr}}@media(max-width:460px){.hx-steps{grid-template-columns:1fr}}</style><section class=\"hx-routine\"><div class=\"hx-routine-inner\"><h2>Your 20-Minute LED Ritual</h2><p class=\"lead\">A simple, comfortable routine designed to support brighter, smoother-looking skin.</p><div class=\"hx-steps\"><div class=\"hx-step\"><span class=\"hx-num\">1</span><h3>Cleanse</h3><p>Begin with clean, dry skin and remove makeup or skincare residue.</p></div><div class=\"hx-step\"><span class=\"hx-num\">2</span><h3>Fit the mask</h3><p>Adjust the flexible silicone mask until it sits comfortably.</p></div><div class=\"hx-step\"><span class=\"hx-num\">3</span><h3>Select and relax</h3><p>Choose your preferred light mode and use for 10–20 minutes.</p></div><div class=\"hx-step\"><span class=\"hx-num\">4</span><h3>Finish your routine</h3><p>Apply serum or moisturizer. Use 3–5 times weekly for consistency.</p></div></div></div></section>",
