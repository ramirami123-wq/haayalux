    "custom_liquid_i8k6n6": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>.hx-faq{padding:56px 20px;background:#FAF4EF;font-family:Arial,sans-serif;color:#241A1A}.hx-faq-inner{max-width:780px;margin:auto}.hx-faq h2{text-align:center;font-size:34px;margin:0 0 8px}.hx-faq .lead{text-align:center;color:#6B5A58;margin:0 0 30px}.hx-faq details{background:#fff;border:1px solid #E8D8D2;border-radius:14px;margin-bottom:10px;padding:0 18px}.hx-faq summary{cursor:pointer;font-weight:700;padding:18px 28px 18px 0;list-style:none;position:relative}.hx-faq summary:after{content:'+';position:absolute;right:0;font-size:22px;color:#7A1830}.hx-faq details[open] summary:after{content:'–'}.hx-faq p{color:#6B5A58;font-size:14px;line-height:1.6;margin:0;padding:0 0 18px}@media(max-width:749px){.hx-faq{padding:40px 16px}.hx-faq h2{font-size:28px}}</style><section class=\"hx-faq\"><div class=\"hx-faq-inner\"><h2>Frequently Asked Questions</h2><p class=\"lead\">Everything you need to know before beginning your LED ritual.</p><details><summary>How do I use the LED mask?</summary><p>Begin with clean, dry skin. Fit the mask comfortably, select your preferred mode and use it for 10–20 minutes. Finish with serum or moisturizer.</p></details><details><summary>How often should I use it?</summary><p>For a consistent routine, use the mask 3–5 times per week. Follow the included instructions and stop if you experience discomfort.</p></details><details><summary>Is it suitable for all skin types?</summary><p>The mask is designed for all skin types. If you are photosensitive, take photosensitizing medication, have an eye condition or are under medical care, consult a qualified professional before use.</p></details><details><summary>What is included?</summary><p>The kit includes the flexible LED face mask, handheld controller, straps, eye inserts and charging cable.</p></details><details><summary>How do payment and delivery work?</summary><p>Cash on delivery is available. Orders are delivered across Lebanon, typically within 2–3 business days.</p></details><details><summary>Do you offer exchanges?</summary><p>Damaged items may be exchanged within 14 days of delivery. Contact Haylux support promptly and keep the original packaging.</p></details></div></section>",
